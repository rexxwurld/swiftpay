# Server
PORT=5000
NODE_ENV=development

# ================= LOGGING =================
# trace|debug|info|warn|error|fatal. Defaults to debug in dev, info in prod.
LOG_LEVEL=

# ================= QUEUE (durable webhook processing) =================
# Redis connection for the BullMQ-backed webhook queue/worker
# (src/queue/*). A free tier from Upstash/Render Redis is enough to
# start. Falls back to redis://127.0.0.1:6379 if unset.
REDIS_URL=redis://127.0.0.1:6379
# Set to "false" to run the worker as its own process (`npm run worker`)
# instead of inside the API process.
WEBHOOK_WORKER_IN_PROCESS=true
WEBHOOK_WORKER_CONCURRENCY=5

# Database
MONGO_URI=your_mongodb_connection_string

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Webhook signing - used to verify incoming "payment succeeded" webhooks.
# Must be IDENTICAL to BANK_WEBHOOK_SECRET set on RexxPay Bank.
BANK_WEBHOOK_SECRET=replace_with_a_long_random_secret



BANK_BASE_URL=replace with the bank base url

# Must match ADMIN_KEY set on Bank.
BANK_ADMIN_KEY=replace_with_a_long_random_secret

# Signs outgoing payout instructions to the Bank's POST /api/v1/payouts.
# Must be IDENTICAL to SWIFTPAY_WEBHOOK_SECRET set on the  Bank (same
# shared secret the bank itself uses to sign deposit webhooks back to us -

BANK_PAYOUT_SECRET=replace_with_a_long_random_secret

# What this service identifies itself as in payout instructions - must
# match the `linkedService` value on the bank Bank side.
LINKED_SERVICE_NAME=swiftpay

# API keys are generated per merchant at signup, not set here.

# ================= OPERATOR / ADMIN =================
# Guards the /api/admin/* routes (provision-pool, pool-status). Fails
# closed - if unset, admin routes reject every request with a 500.

# Used only for /api/admin/* routes you trigger yourself (stuck-payment
# resolution, pool provisioning, fee overrides). Never sent as a URL
# parameter - header (x-admin-key) only.

INFRA_ADMIN_KEY=replace_with_a_long_random_secret

# Named admin accounts (see src/modules/admin/adminUser.model.js). Required
# in addition to INFRA_ADMIN_KEY for money-moving admin actions (resolving
# stuck payouts/withdrawals/refunds, releasing/rejecting flagged
# transactions) so those specific actions are tied to an actual named
# person, not just "whoever has the shared key". Deliberately a SEPARATE
# secret from JWT_SECRET - see config/env.js for why. Bootstrap the first
# account with: node scripts/create-admin-user.js <email> <role>
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
ADMIN_JWT_EXPIRES_IN=12h

# Comma-separated list of origins allowed to make cookie-authenticated
# (credentialed) requests to the API - your hosted dashboard's real
# origin(s), nothing else. Example:
# CORS_ALLOWED_ORIGINS=https://domain-namen.com
CORS_ALLOWED_ORIGINS=

# Used only by /api/admin/cron/* routes, meant to be called by an
# external scheduler (cron-job.org, GitHub Actions, etc.). Separate
# secret from INFRA_ADMIN_KEY on purpose - it's lower-privilege and
# travels in the URL, so it should be rotatable independently without
# touching your operator admin key.
CRON_TRIGGER_KEY=

# ================= RISK & COMPLIANCE =================
# Comma-separated full names (case-insensitive) to test the sanctions-hit
# flagging path locally. Dev-only stand-in for a real screening provider -
# see utils/sanctionsCheck.js. Leave empty/unset in normal dev use.
SANCTIONS_DENYLIST_DEV=

# All optional - override the defaults baked into config/limits.js.
# Amounts are in minor units (kobo).
MIN_SINGLE_PAYMENT_MINOR=10000
MAX_SINGLE_PAYMENT_MINOR=50000000
MAX_DAILY_INBOUND_MINOR=500000000
VELOCITY_WINDOW_MINUTES=10
VELOCITY_MAX_COUNT=5
MAX_SINGLE_PAYOUT_MINOR=200000000
VIRTUAL_ACCOUNT_EXPIRY_MINUTES=60
DISPUTE_EVIDENCE_WINDOW_DAYS=7

# ================= ACCOUNT POOL AUTO-TOPUP =================
# All optional - override the defaults baked into config/limits.js.
# If a bank partner's available-account count drops at or below
# POOL_MIN_THRESHOLD, POOL_TOPUP_COUNT new accounts are provisioned for
# that bank (see scripts/auto-provision-pool.js).
POOL_MIN_THRESHOLD=20
POOL_TOPUP_COUNT=20

# ================= SETTLEMENT =================
# How long a confirmed inbound payment sits pending before it's eligible
# to settle. Default is a conservative T+1 (24h, in minutes).
SETTLEMENT_CUTOFF_MINUTES=1440
# Extra hold between "settled" and actually payable. 0 = payable as soon
# as settled.
SETTLEMENT_AVAILABILITY_DELAY_MINUTES=0
# Max transactions processed per settlement batch run, per phase.
SETTLEMENT_BATCH_SIZE=500

# ================= PLATFORM FEES =================
# All optional - override the defaults baked into config/fees.js.
# What RexxPay charges merchants per transaction.
PLATFORM_FEE_BPS=150
PLATFORM_FEE_FIXED_MINOR=10000
PLATFORM_FEE_CAP_MINOR=200000
PLATFORM_FEE_WAIVE_BELOW_MINOR=250000
